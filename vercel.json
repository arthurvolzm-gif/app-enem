{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/quiz1", "permanent": false },
    { "source": "/quiz-enem", "destination": "/quiz2", "permanent": false }
  ],
  "rewrites": [
    { "source": "/reda%C3%A7%C3%A3o", "destination": "/redacao/index.html" },
    { "source": "/redação", "destination": "/redacao/index.html" },
    { "source": "/mat%C3%A9rias", "destination": "/materias/index.html" },
    { "source": "/matérias", "destination": "/materias/index.html" }
  ],
  "functions": {
    "api/corrigir.js": { "maxDuration": 90 }
  },
  "headers": [
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] },
    { "source": "/(redacao|materias)(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] }
  ]
}
